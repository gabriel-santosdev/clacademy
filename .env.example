# ── Obrigatório em produção ─────────────────────────────────
# Postgres (Neon, Supabase…). Vazio = banco local PGlite em .data/ (só dev)
NUXT_DATABASE_URL=
# Supabase: "Session pooler" (porta 5432), usado só pelas migrations. Vazio = usa NUXT_DATABASE_URL
NUXT_DATABASE_MIGRATION_URL=
# Segredo da sessão (mín. 32 caracteres). Em dev é gerado automaticamente.
NUXT_SESSION_PASSWORD=
# Primeiro admin, criado quando o banco está vazio (produção)
NUXT_ADMIN_EMAIL=
NUXT_ADMIN_PASSWORD=
NUXT_PUBLIC_SITE_URL=https://clacademy.com.br

# ── Pagamentos ──────────────────────────────────────────────
# manual = Pix/dinheiro com baixa pelo admin | asaas = cobrança automática
NUXT_PAYMENT_PROVIDER=manual
# chave de produção ($aact_prod_…) e de teste ($aact_hmlg_…); SANDBOX escolhe qual usar
NUXT_PAYMENT_ASAAS_API_KEY=
NUXT_PAYMENT_ASAAS_SANDBOX_API_KEY=
NUXT_PAYMENT_ASAAS_SANDBOX=true
# Mesmo token configurado no painel do Asaas (Integrações → Webhooks)
NUXT_PAYMENT_ASAAS_WEBHOOK_TOKEN=

# ── Notificações push (gere com: npx web-push generate-vapid-keys) ──
NUXT_PUBLIC_VAPID_PUBLIC_KEY=
NUXT_VAPID_PRIVATE_KEY=
NUXT_VAPID_SUBJECT=mailto:contato@clacademy.com.br

# ── Strava (https://www.strava.com/settings/api) ────────────
# Authorization Callback Domain: seu domínio (ex: clacademy.com.br)
NUXT_STRAVA_CLIENT_ID=
NUXT_STRAVA_CLIENT_SECRET=

# ── E-mail (https://resend.com) ─────────────────────────────
# Vazio = e-mails só aparecem no terminal (dev)
NUXT_EMAIL_RESEND_API_KEY=
# Remetente com domínio verificado no Resend
NUXT_EMAIL_FROM=CL Academy <nao-responda@clacademy.com.br>
# Para onde vão as respostas dos alunos (opcional)
NUXT_EMAIL_REPLY_TO=
